    "    test_samples.append(sample)\n",
    "    test_labels.append(label)\n",
    "\n",
    "pred_probs= make_predictions(model=model_2,\n",
    "                             data=test_samples)\n",
    "pred_classes = pred_probs.argmax(dim=1)"
   ]
